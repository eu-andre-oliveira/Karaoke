# Copie para .env e ajuste. O .env real nunca vai para o git.

# Senha do Postgres (obrigatória)
POSTGRES_PASSWORD=troque-esta-senha

# Porta publicada no host (o nginx do container "web")
WEB_PORT=8080

# Opcional: cria um admin na primeira subida. Deixe vazio para não criar.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
